rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Application validation
    function isValidApplication(data) {
      return data.keys().hasAll(['fullName', 'email', 'phone', 'position', 'experience', 'submittedAt', 'status'])
        && data.fullName is string && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.position is string
        && data.experience is string
        && data.submittedAt == request.time
        && data.status == 'pending'
        && (data.get('platforms', []) is list)
        && (data.get('skills', []) is list)
        && (data.get('tools', []) is list)
        && (data.get('imageUrls', {}) is map);
    }

    match /applications/{applicationId} {
      allow create: if isValidId(applicationId) && isValidApplication(incoming());
      allow read, list, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
    }
  }
}
